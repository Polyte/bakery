YOCO_SECRET_KEY=sk_test_your_key_here
YOCO_WEBHOOK_SECRET=whsec_your_secret_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_EMAIL=info@daddasconfectionery.co.za

# Required in production. In development a random secret is generated per server process.
SESSION_SECRET=
JWT_SECRET=

# PostgreSQL (see docker-compose.yml — maps host port 5434)
DATABASE_URL=postgresql://dadda:dadda_dev@localhost:5434/dadda_bakery?schema=public

# Optional. Caches delivery autocomplete/quotes and Instagram. In-memory fallback if unset.
REDIS_URL=redis://localhost:6379

# Object storage (optional — local public/ used if unset)
STORAGE_CONNECTION=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Transactional email provider: smtp | sendgrid | resend | mailgun
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Payments
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# WhatsApp Business API (optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Analytics
ANALYTICS_ID=
NEXT_PUBLIC_GA_ID=
